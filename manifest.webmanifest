{
  "name": "TypeTalk - Typing, Listening & Speaking Practice",
  "short_name": "TypeTalk",
  "description": "Free, offline-friendly practice app for typing speed, dictation (listen & type), reading aloud and shadowing. Four difficulty levels, milestones, badges and detailed stats - all stored on your device.",
